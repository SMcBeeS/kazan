// cSpell configuration for the AnimeGate project.
//
// Two sources of dictionary entries:
//   1. "project-arabic"  -> cspell-words.txt, an auto-generated list of every
//      Arabic word used in src/ (i18n translations, labels, Arabic comments).
//      Regenerate with:  node gen_spell_dict.cjs
//   2. "anime-tech"      -> inline allow-list of proper nouns / domain terms
//      (AniList API names, anime genres, streaming & font terms, HTML entity
//      shorthand, etc.).
//
// The VS Code "Code Spell Checker" extension and the cspell CLI both read this
// file, so `npm run build` stays clean (tsc) AND the Problems panel stays quiet.
{
  "version": "0.2",
  "language": "en",
  "enableGlobally": false,
  "dictionaries": ["project-arabic", "anime-tech"],
  "dictionaryDefinitions": [
    {
      "name": "project-arabic",
      "path": "cspell-words.txt",
      "addWords": true
    },
    {
      "name": "anime-tech",
      "words": [
        "anilist",
        "Anilist",
        "animegate",
        "AnimeGate",
        "animeverse",
        "animes",
        "Jikan",
        "romaji",
        "naruto",
        "ecchi",
        "hentai",
        "mecha",
        "mahou",
        "seinen",
        "shounen",
        "shoujo",
        "josei",
        "Tajawal",
        "Segoe",
        "MYMEMORY",
        "mymemory",
        "bypopularity",
        "pillarbars",
        "crossfade",
        "Crossfading",
        "centralises",
        "authorised",
        "uppercased",
        "localised",
        "gakuzuka",
        "webvtt",
        "mpegurl",
        "langpair",
        "subtitles",
        "Notif",
        "hellip",
        "ndash",
        "rsquo",
        "lsquo",
        "hls",
        "webm",
        "Webm",
        "wordmark",
        "KAZAN",
        "kazan",
        "kanji",
        "island",
        "supabase",
        "vercel",
        "vite",
        "clsx",
        "zustand",
        "graphql",
        "anij",
        "shikimori",
        "animes",
        "watchlist",
        "upsert",
        "normalise",
        "neighbours",
        "behaviour",
        "favourite",
        "favs",
        "loggedin",
        "onhold",
        "signups",
        "crunchyroll",
        "edgerunners",
        "evergarden",
        "frieren",
        "hajimeru",
        "isekai",
        "iyashikei",
        "kaguya",
        "kaisen",
        "kimetsu",
        "kyojin",
        "lolicon",
        "otaku",
        "sama",
        "seikatsu",
        "shingeki",
        "sousou",
        "wistoria",
        "yaiba",
        "dubbed",
