        "الخميس",
        "الجمعة",
        "السبت",
        "الأحد",
        "التو",
        "دقيقة",
        "ساعة"
      ]
    }
  ],
  "ignorePaths": [
    "src/i18n/**",
    "node_modules/**",
    "dist/**",
    "build/**",
    ".git/**",
    "coverage/**",
    "*.min.js",
    "*.min.css",
    "*.lock",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "cspell-words.txt",
    "gen_spell_dict.cjs",
    "spell_*.txt",
    ".cspell_test.ts",
    ".c_config*.json",
    ".env.local",
    "cspell_out.txt"
  ]
}